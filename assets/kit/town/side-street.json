{
  "id": "town/side-street",
  "version": 1,
  "what": "A side street's tarmac stub, a low pad joining the main road at a simple junction (300 mm tall so it clears the ground it lies across). Length along x (away from the road).",
  "params": {
    "lengthMm": {
      "min": 16000,
      "max": 60000,
      "default": 32000
    },
    "widthMm": {
      "min": 6000,
      "max": 10000,
      "default": 8000
    }
  },
  "collider": {
    "box": {
      "x": {
        "param": "lengthMm"
      },
      "y": 300,
      "z": {
        "param": "widthMm"
      }
    }
  },
  "lod": {
    "simplifyBeyondMm": 80000,
    "cullBeyondMm": 400000
  }
}
