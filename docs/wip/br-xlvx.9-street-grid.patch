index 00000000..8edb64e6
--- /dev/null
+++ b/crates/jj-procgen/src/course/grid.rs
@@ -0,0 +1,91 @@
+//! R125 town streets: a simple lattice polygon, rounded at its intersections.
+//! The upper edge is the highway. Longer blocks add a street chicane on the
+//! return leg; no edge or intersection is reused and nothing crosses at grade.
+use super::*;
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct StreetGrid {
+    pub block_m: f64,
+    pub block_depth_m: f64,
+    pub highway: (f64, f64),
+    pub chicane: bool,
+}
+
+pub fn design_grid(rng: &mut Rng, data: &CourseData) -> Option<Course> {
+    let class = draw_class(rng, data);
+    let band = data.classes.get(class);
+    let g = data.street_grid;
+    for attempt in 1..=MAX_ATTEMPTS {
+        let pitch = rng.range(g.block_min_m, g.block_max_m);
+        let depth = g.block_min_m;
+        // Keep the biome boundary on the straight, clear of the highway corner.
+        let boundary_clear = crate::biome::select::TRANSITION_M;
+        let min_x = libm::ceil((g.highway_min_m + boundary_clear + 2.0 * g.highway_radius_m) / pitch) as usize;
+        let max_x = libm::floor((g.highway_max_m + boundary_clear + 2.0 * g.highway_radius_m) / pitch) as usize;
+        let max_y = libm::ceil(band.length_max_m / (2.0 * depth)) as usize;
+        let mut candidates = Vec::new();
+        for nx in min_x..=max_x {
+            for ny in 1..=max_y {
+                for chicane in [false, true] {
+                    if chicane && (ny < 3 || nx < 5) {
+                        continue;
+                    }
+                    let mut vertices = vec![(0.0, 0.0), (nx as f64 * pitch, 0.0),
+                        (nx as f64 * pitch, ny as f64 * depth)];
+                    if chicane {
+                        // Two neighbouring blocks form a left-right-left-right
+                        // dogleg. All vertices are real grid intersections.
+                        vertices.extend([
+                            ((nx - 1) as f64 * pitch, ny as f64 * depth),
+                            ((nx - 1) as f64 * pitch, (ny - 1) as f64 * depth),
+                            ((nx - 3) as f64 * pitch, (ny - 1) as f64 * depth),
+                            ((nx - 3) as f64 * pitch, ny as f64 * depth),
+                        ]);
+                    }
+                    vertices.push((0.0, ny as f64 * depth));
+                    let (corners, pieces) = rounded(&vertices, g.corner_radius_m, g.highway_radius_m);
+                    let points = sample(&pieces);
+                    let len = length(&points);
+                    if (band.length_min_m..=band.length_max_m).contains(&len) {
+                        candidates.push((corners, pieces, points, len, chicane));
+                    }
+                }
+            }
+        }
+        if candidates.is_empty() {
+            continue;
+        }
+        let at = (rng.unit() * candidates.len() as f64) as usize;
+        let (corners, pieces, points, len, chicane) = candidates.swap_remove(at);
+        if !self_clear(&points) {
+            continue;
+        }
+        let highway = match pieces[0] { Piece::Straight(l) => (0.0, l - boundary_clear), _ => unreachable!() };
+        return Some(Course {
+            corners, straights: straights(&pieces), points, length_m: len,
+            class, preset: PresetName::Flowing, attempts: attempt,
+            fallback: false, rejects: BTreeMap::new(), crossing: None,
+            street_grid: Some(StreetGrid { block_m: pitch, block_depth_m: depth, highway, chicane }),
+        });
+    }
+    // Impossible tuned bands are a rejected generation, never a mislabeled oval.
+    None
+}
+
+fn rounded(v: &[(f64, f64)], street: f64, highway: f64) -> (Vec<Corner>, Vec<Piece>) {
+    let n = v.len();
+    let radius = |i: usize| if i < 2 { highway } else { street };
+    let mut pieces = Vec::new();
+    let mut corners = Vec::new();
+    for i in 0..n {
+        let j = (i + 1) % n;
+        let k = (i + 2) % n;
+        let a = (v[j].0 - v[i].0, v[j].1 - v[i].1);
+        let b = (v[k].0 - v[j].0, v[k].1 - v[j].1);
+        let turn = libm::atan2(a.0 * b.1 - a.1 * b.0, a.0 * b.0 + a.1 * b.1);
+        pieces.push(Piece::Straight(libm::hypot(a.0, a.1) - radius(i) - radius(j)));
+        pieces.push(Piece::Arc { turn, radius: radius(j) });
+        corners.push(Corner { kind: if j < 2 { CornerKind::Sweeper } else { CornerKind::Medium }, turn, radius: radius(j) });
+    }
+    (corners, pieces)
+}
