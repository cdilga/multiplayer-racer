+#[test]
+fn grid_autopilot_laps_and_replays() {
+    let registry = jj_procgen::registry();
+    let data = forced();
+    let first = std::env::var("JJ_SEED_FROM").ok().and_then(|s| s.parse().ok()).unwrap_or(0);
+    let end = std::env::var("JJ_SEEDS").ok().and_then(|s| s.parse().ok()).unwrap_or(8);
+    for seed in first..end {
+        let (raw, report) = jj_procgen::generate_tuned_from(Streams::new(seed), &[Biome::Town], &data).unwrap();
+        assert!(report.street_grid.is_some());
+        let map = load_canonical(&canonical_bytes(&raw), &registry).unwrap();
+        let profile = jj_sim::VehicleProfile::cruz();
+        let mut sim = jj_sim::Sim::new(&map, &registry, seed, profile.clone());
+        let car = sim.spawn_grid(1)[0];
+        sim.start_race(1);
+        sim.set_autopilot(car, true);
+        let mut min_up = 1.0f32;
+        while !sim.race().is_finished(car.0) && sim.tick() < 400 * u64::from(jj_sim::TICK_HZ) {
+            sim.step();
+            min_up = min_up.min(sim.car_state(car).unwrap().up_y);
+        }
+        let race = sim.race().car(car.0).unwrap();
+        if race.finished_at.is_none() {
+            let state = sim.car_state(car).unwrap();
+            let at = raw.route.points.iter().enumerate().min_by(|(_,a),(_,b)| {
+                let d = |p: &jj_map::RoutePoint| (p.x as f64 / 1000.0 - state.position[0] as f64).powi(2) + (p.z as f64 / 1000.0 - state.position[2] as f64).powi(2);
+                d(a).total_cmp(&d(b))
+            }).unwrap();
+            eprintln!("stalled: {state:?}; nearest route {at:?}");
+            if let Some(dir) = std::env::var_os("JJ_EVIDENCE_DIR") {
+                std::fs::create_dir_all(&dir).unwrap();
+                std::fs::write(std::path::Path::new(&dir).join(format!("grid-seed{seed}-stalled-map.json")), serde_json::to_string_pretty(&raw).unwrap()).unwrap();
+            }
+        }
+        eprintln!("grid seed{seed} {:?} {:.1}m: {} ticks, upY {min_up}, recoveries {}, wrecks {}", report.class, report.length_m, sim.tick(), race.recoveries, race.wrecks);
+        assert!(race.finished_at.is_some(), "seed{seed} stalled");
+        assert_eq!((race.recoveries, race.wrecks), (0, 0));
+        assert!(min_up > 0.5);
+        let replay = jj_sim::Sim::replay(&map, &registry, profile, sim.journal(), sim.tick());
+        assert_eq!(sim.state_hash(), replay.state_hash());
+    }
+}
