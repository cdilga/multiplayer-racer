+//! br-xlvx.9: inspect the generated blocks and highway, then drive and replay
+//! the actual heightfield with all its town furniture and features intact.
+#![cfg(not(target_arch = "wasm32"))]
+use jj_map::{Biome, canonical_bytes, load_canonical};
+use jj_procgen::{seed::Streams, tuning::GeneratorData};
+
+fn forced() -> GeneratorData {
+    let mut data = GeneratorData::shipped().clone();
+    data.course.street_grid.probability = 1.0;
+    data
+}
+
+#[test]
+fn seed_bank_has_grid_corners_highway_width_and_no_rocks() {
+    let data = forced();
+    let registry = jj_procgen::registry();
+    let mut rows = Vec::new();
+    let mut classes = std::collections::BTreeSet::new();
+    let mut chicanes = 0;
+    for seed in 0..40 {
+        let (map, report) = jj_procgen::generate_tuned_from(Streams::new(seed), &[Biome::Town], &data).unwrap();
+        let grid = report.street_grid.expect("grid choice cannot become an ordinary course");
+        assert!((60.0..=90.0).contains(&grid.block_m));
+        assert!((300.0..=500.0).contains(&(grid.highway.1 - grid.highway.0)));
+        let right = report.corner_angles_deg.iter().filter(|a| (a.abs() - 90.0).abs() <= 10.0).count();
+        assert!(right * 10 >= report.corner_angles_deg.len() * 7);
+        assert!(map.dressing.iter().all(|d| !d.kit_piece.contains("rock")));
+        assert!(map.props.iter().all(|p| !p.kit_piece.contains("rock")));
+        assert_eq!(map.route.points.iter().map(|p| p.width).min(), Some(12_000));
+        assert_eq!(map.route.points.iter().map(|p| p.width).max(), Some(18_000));
+        let band = data.course.classes.get(report.class);
+        assert!((band.length_min_m..=band.length_max_m).contains(&report.length_m));
+        assert!(jj_procgen::validate::check(&map, &registry).is_empty(), "seed {seed}: {:?}", jj_procgen::validate::check(&map, &registry));
+        assert!(!report.fallback);
+        classes.insert(report.class);
+        chicanes += usize::from(grid.chicane);
+        rows.push(serde_json::json!({"seed":seed,"class":report.class.name(),"lengthM":report.length_m,"blockM":grid.block_m,"highwayM":grid.highway.1,"cornersDeg":report.corner_angles_deg,"chicane":grid.chicane}));
+    }
+    assert_eq!(classes.len(), 3);
+    assert!(chicanes > 0, "the bank must include block chicanes");
+    if let Some(dir) = std::env::var_os("JJ_EVIDENCE_DIR") {
+        std::fs::create_dir_all(&dir).unwrap();
+        std::fs::write(std::path::Path::new(&dir).join("street-grid-bank.json"), serde_json::to_string_pretty(&rows).unwrap()).unwrap();
+    }
+}
