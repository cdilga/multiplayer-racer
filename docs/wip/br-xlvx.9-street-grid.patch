+fn grid_selection_is_town_only_and_about_twenty_percent() {
+    let data = GeneratorData::shipped();
+    let mut chosen = 0;
+    for seed in 0..1000 {
+        // Selection uses only the structure stream and no generation retry.
+        let mut rng = Streams::new(seed).structure;
