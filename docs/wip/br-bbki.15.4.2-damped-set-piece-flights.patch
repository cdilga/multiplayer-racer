+/// br-glso: a branch's ground changes grade smoothly all along it, ends included, so a car coming off it at speed onto a
+/// main road on a steep grade isn't thrown (seed 27's straight ramp met a 12 % downhill at a crest and launched a bot
+/// across the road). The change of grade between consecutive 5 m spans of the stamped ground under the branch, on the
+/// race-prepared courses the bot bank drives.
+#[test]
+fn every_branch_meets_the_road_without_a_crest_or_a_dip() {
+    let mut worst = (0.0f64, String::new());
+    let mut forks_seen = 0;
+    for seed in 0..PLAYTEST_SEEDS {
+        let p = jj_procgen::playtest::prepare(seed);
+        let map = &p.map;
+        for f in map.features.iter().filter(|f| f.kind == FeatureKind::Fork) {
+            let d = Fork::of(f).unwrap();
+            let path = fork::path_of(map, &d);
+            let g = |q: &[f64; 2]| jj_map::jump::ground_height_m(&map.terrain, q[0], q[1]);
+            // Two path steps (5 m) a span, as the validator measures grade.
+            let grade = |k: usize| {
+                let (a, b) = (&path[k], &path[k + 2]);
+                (g(b) - g(a)) / (b[0] - a[0]).hypot(b[1] - a[1]).max(1e-9)
+            };
+            forks_seen += 1;
+            for k in 0..path.len().saturating_sub(4) {
+                let change = (grade(k + 2) - grade(k)).abs();
+                if change > worst.0 {
+                    worst = (
+                        change,
+                        format!(
+                            "seed {seed} fork {}..{} at branch point {k} of {}",
+                            d.from,
+                            d.to,
+                            path.len()
+                        ),
+                    );
+                }
+            }
+        }
+    }
+    eprintln!(
+        "{forks_seen} forks; the largest change of grade between 5 m spans: {:.3} ({})",
+        worst.0, worst.1
+    );
+    assert!(forks_seen > 0);
+    assert!(
+        worst.0 <= MAX_GRADE_CHANGE,
+        "a branch changes grade by {:.3} between 5 m spans: {}",
+        worst.0,
+        worst.1
+    );
+}
+
+/// The bot bank's seeds (bank.rs).
+const PLAYTEST_SEEDS: u64 = 30;
+/// The most a branch's grade may change between consecutive 5 m spans.
+const MAX_GRADE_CHANGE: f64 = 0.08;
+
 /// The first seeds of a biome whose courses have a fork, `count` of them.
 fn forked(biome: Biome, count: usize) -> Vec<u64> {
     (0..SEEDS * 4)
