+/// br-bbki.15.4.2: every gap-leap kind's predicted touchdown (`setpiece::touchdown`, flown with
+/// `FLIGHT_DAMPING_PER_S`, the roster's most damped car's: the Tradie Ute's 0.19/s) against the Ute's real one, leaving
+/// the lip at the bottom, middle and top of the piece's band, on 10 seeds per biome; and the least damped car (0.14/s)
+/// at the top of the band still comes down on the landing.
+#[test]
+fn every_gap_leap_lands_where_its_flight_predicts_across_its_band() {
+    let roster =
+        VehicleProfile::roster(&std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../.."))
+            .unwrap();
+    let damping = |p: &VehicleProfile| p.tuning.linear_damping;
+    let most = roster
+        .iter()
+        .max_by(|a, b| damping(&a.1).total_cmp(&damping(&b.1)))
+        .unwrap();
+    let least = roster
+        .iter()
+        .min_by(|a, b| damping(&a.1).total_cmp(&damping(&b.1)))
+        .unwrap();
+    assert!(
+        (f64::from(damping(&most.1)) - jj_map::setpiece::limits::FLIGHT_DAMPING_PER_S).abs() < 1e-6,
+        "FLIGHT_DAMPING_PER_S is the roster's largest linear_damping ({} {})",
+        most.0,
+        damping(&most.1)
+    );
+    let mut table = String::from(
+        "biome seed piece kind lip_mps predicted_m real_m (most damped) least_damped_at_top_m landing_end_m\n",
+    );
+    let (mut bad, mut kinds) = (Vec::new(), BTreeMap::new());
+    for biome in BIOMES {
+        for seed in 0..10 {
+            let map = loaded(seed, biome);
+            let pieces: Vec<_> = map
+                .map
+                .features
+                .iter()
+                .filter(|f| GapLeap::of(f).is_some())
+                .collect();
+            for (k, f) in pieces.iter().enumerate() {
+                let d = GapLeap::of(f).unwrap();
+                for v in [d.min_speed, (d.min_speed + d.max_speed) / 2.0, d.max_speed] {
+                    let Some((predicted, _)) = jj_map::setpiece::touchdown(&map.map, f, &d, v)
+                    else {
+                        bad.push(format!(
+                            "{biome:?} {seed} {k}: no predicted touchdown at {v:.1} m/s"
+                        ));
+                        continue;
+                    };
+                    let Some(real) = flown(&map, f, &d, v, &most.1) else {
+                        bad.push(format!(
+                            "{biome:?} {seed} {k} {} at {v:.1} m/s: never came down",
+                            d.kind.name()
+                        ));
+                        continue;
+                    };
+                    let top = if v == d.max_speed {
+                        flown(&map, f, &d, v, &least.1)
+                    } else {
+                        None
+                    };
+                    writeln!(
+                        table,
+                        "{biome:?} {seed} {k} {} {v:.1} {predicted:.1} {real:.1} {} {:.1}",
+                        d.kind.name(),
+                        top.map_or("-".into(), |x| format!("{x:.1}")),
+                        d.gap_m + d.landing_m
+                    )
+                    .unwrap();
+                    if let Some(x) = top
+                        && x > d.gap_m + d.landing_m
+                    {
+                        bad.push(format!("{biome:?} seed {seed} piece {k} ({}): {} at {v:.1} m/s comes down at {x:.1} m, past the landing's end {:.1} m", d.kind.name(), least.0, d.gap_m + d.landing_m));
+                    }
