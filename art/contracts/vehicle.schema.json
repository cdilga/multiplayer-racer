{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jj.vehicle.v1",
  "title": "Joystick Jammers vehicle asset sidecar (jj.vehicle.v1)",
  "description": "The sidecar next to a vehicle's LOD GLBs (plan §6.2, P1-V01). `jj validate <vehicle>.asset.json` checks it and the GLB data itself (crates/jj-contracts). Units metres, +y up, +z forward, origin on the ground between the axles. Parts intact → loose → detached (R86); every part except core hinges when loose.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "id", "units", "forward", "up", "lods", "parts", "anchors", "material"],
  "properties": {
    "contract": { "const": "jj.vehicle.v1" },
    "id": { "type": "string", "minLength": 1 },
    "units": { "const": "m" },
    "forward": { "const": "+z" },
    "up": { "const": "+y" },
    "lods": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "description": "One GLB per LOD, LOD0 first. maxTris may be lower than the qualified budgets (1300 / 900 / 600), never higher.",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["file", "maxTris"],
        "properties": { "file": { "type": "string" }, "maxTris": { "type": "integer", "minimum": 1 } }
      }
    },
    "parts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "front", "back", "door_FL", "door_FR", "door_RL", "door_RR", "wheel_FL", "wheel_FR", "wheel_RL", "wheel_RR"],
      "properties": {
        "core": { "$ref": "#/$defs/part" }, "front": { "$ref": "#/$defs/part" }, "back": { "$ref": "#/$defs/part" },
        "door_FL": { "$ref": "#/$defs/part" }, "door_FR": { "$ref": "#/$defs/part" }, "door_RL": { "$ref": "#/$defs/part" }, "door_RR": { "$ref": "#/$defs/part" },
        "wheel_FL": { "$ref": "#/$defs/part" }, "wheel_FR": { "$ref": "#/$defs/part" }, "wheel_RL": { "$ref": "#/$defs/part" }, "wheel_RR": { "$ref": "#/$defs/part" }
      }
    },
    "interiors": {
      "description": "Interior blocks (P1-V03): what shows through where a part is loose or gone. Each id has a GLB node interior_<id> in vehicle space on the atlas material, drawn only for a car whose exposedBy part isn't intact.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["exposedBy"],
        "properties": { "exposedBy": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
      }
    },
    "anchors": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/vec3" },
      "required": ["cam_fp", "cam_tp_target", "com", "roof_number", "lplate_front", "lplate_rear"]
    },
    "material": {
      "type": "object", "additionalProperties": false, "required": ["count", "atlas"],
      "properties": { "count": { "const": 1 }, "atlas": { "type": "string", "description": "The single atlas; it carries the paint key." } }
    }
  },
  "$defs": {
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "part": {
      "type": "object", "additionalProperties": false, "required": ["pivot", "hinge", "massFraction", "collider"],
      "properties": {
        "pivot": { "$ref": "#/$defs/vec3" },
        "hinge": {
          "description": "null for core; otherwise the loose swing: a unit axis in vehicle space and limits in degrees (min < max).",
          "oneOf": [
            { "type": "null" },
            { "type": "object", "additionalProperties": false, "required": ["axis", "min", "max"],
              "properties": { "axis": { "$ref": "#/$defs/vec3" }, "min": { "type": "number", "minimum": -180 }, "max": { "type": "number", "maximum": 180 } } }
          ]
        },
        "massFraction": { "type": "number", "exclusiveMinimum": 0, "description": "All parts sum to 1 ± 0.01." },
        "collider": {
          "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": { "type": { "enum": ["convex", "cuboid", "capsule"], "description": "core must be rounded: convex or capsule." } }
        }
      }
    }
  }
}
