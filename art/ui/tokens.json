{
  "$schema": "./tokens.schema.json",
  "name": "Joystick Jammers UI tokens",
  "version": "0.1.0",
  "status": "draft",
  "statusNote": "Draft from P1-U01. C01 and D05 build from this draft; every other UI task waits for the owner's G-DESIGN verdict (P1-U04), which freezes the accepted copy in art/ui/accepted/<date>/.",
  "references": {
    "primary": "docs/plans/ux-study-2026-09-29/images/H4-host-round-results-v2.png",
    "controls": "docs/plans/ux-study-2026-09-29/images/M2-mobile-control-settings-v2.png",
    "car": "spikes/art-pipeline/J-cruze-lowpoly/out/evidence/ladder_L0_hero.png",
    "superseded": [
      "art/style/refs/ui_lobby.png"
    ]
  },
  "palette": {
    "ink": {
      "hex": "#15203A",
      "role": "Deep navy ink: outlines, text on paper, the controller's dark base"
    },
    "ink-raised": {
      "hex": "#1F2D4F",
      "role": "Raised surface on the ink base (controller panels in a dim room)"
    },
    "ink-soft": {
      "hex": "#3D4A6B",
      "role": "Muted ink text on paper (secondary labels)"
    },
    "paper": {
      "hex": "#FFF4DE",
      "role": "Warm paper cream: TV panels and text on ink"
    },
    "paper-shade": {
      "hex": "#F1E2C2",
      "role": "Recessed paper (rows, wells, disabled fills)"
    },
    "paper-line": {
      "hex": "#D9C6A0",
      "role": "Hairlines and dividers on paper"
    },
    "saffron": {
      "hex": "#FFB400",
      "role": "Primary accent: primary buttons, highlight bars, timer emphasis"
    },
    "cobalt": {
      "hex": "#1E5BFF",
      "role": "Secondary accent: links, selection, keyboard focus, numbers on paper"
    },
    "cobalt-deep": {
      "hex": "#1442C4",
      "role": "Cobalt text on paper at small sizes"
    },
    "teal": {
      "hex": "#00C2B8",
      "role": "Festival accent, sparingly"
    },
    "red-earth": {
      "hex": "#C8622E",
      "role": "World colour: red dirt (backgrounds and illustration, not UI text)"
    },
    "ochre": {
      "hex": "#D9A441",
      "role": "World colour: sun-bleached ochre"
    },
    "sandstone": {
      "hex": "#E0B389",
      "role": "World colour: sandstone"
    },
    "danger": {
      "hex": "#B3261E",
      "role": "Destructive actions and errors"
    },
    "danger-tint": {
      "hex": "#FBE3DD",
      "role": "Destructive secondary fill and error panels"
    },
    "success": {
      "hex": "#17703A",
      "role": "Ready, connected, saved"
    },
    "success-tint": {
      "hex": "#DDF2DF",
      "role": "Success panels"
    },
    "warning": {
      "hex": "#FF7A00",
      "role": "Reconnecting, weak signal"
    },
    "warning-tint": {
      "hex": "#FFE6CC",
      "role": "Warning toasts and reconnecting panels (ink text)"
    },
    "white": {
      "hex": "#FFFFFF",
      "role": "QR background only"
    },
    "black": {
      "hex": "#000000",
      "role": "QR modules only"
    }
  },
  "contrastPairs": [
    {
      "name": "text-on-paper",
      "fg": "ink",
      "bg": "paper",
      "size": "normal"
    },
    {
      "name": "text-on-paper-shade",
      "fg": "ink",
      "bg": "paper-shade",
      "size": "normal"
    },
    {
      "name": "muted-on-paper",
      "fg": "ink-soft",
      "bg": "paper",
      "size": "normal"
    },
    {
      "name": "muted-on-paper-shade",
      "fg": "ink-soft",
      "bg": "paper-shade",
      "size": "normal"
    },
    {
      "name": "text-on-ink",
      "fg": "paper",
      "bg": "ink",
      "size": "normal"
    },
    {
      "name": "text-on-ink-raised",
      "fg": "paper",
      "bg": "ink-raised",
      "size": "normal"
    },
    {
      "name": "primary-button",
      "fg": "ink",
      "bg": "saffron",
      "size": "large"
    },
    {
      "name": "primary-button-label",
      "fg": "ink",
      "bg": "saffron",
      "size": "normal"
    },
    {
      "name": "cobalt-button",
      "fg": "paper",
      "bg": "cobalt",
      "size": "large"
    },
    {
      "name": "cobalt-number-on-paper",
      "fg": "cobalt",
      "bg": "paper",
      "size": "large"
    },
    {
      "name": "cobalt-text-on-paper",
      "fg": "cobalt-deep",
      "bg": "paper",
      "size": "normal"
    },
    {
      "name": "destructive-button",
      "fg": "paper",
      "bg": "danger",
      "size": "normal"
    },
    {
      "name": "destructive-text-on-tint",
      "fg": "danger",
      "bg": "danger-tint",
      "size": "normal"
    },
    {
      "name": "success-text-on-tint",
      "fg": "success",
      "bg": "success-tint",
      "size": "normal"
    },
    {
      "name": "success-text-on-paper",
      "fg": "success",
      "bg": "paper",
      "size": "normal"
    },
    {
      "name": "text-on-warning-tint",
      "fg": "ink",
      "bg": "warning-tint",
      "size": "normal"
    },
    {
      "name": "warning-text-on-ink",
      "fg": "warning",
      "bg": "ink",
      "size": "normal"
    },
    {
      "name": "saffron-text-on-ink",
      "fg": "saffron",
      "bg": "ink",
      "size": "normal"
    },
    {
      "name": "outline-on-paper",
      "fg": "ink",
      "bg": "paper",
      "size": "ui"
    },
    {
      "name": "focus-ring-on-paper",
      "fg": "cobalt",
      "bg": "paper",
      "size": "ui"
    },
    {
      "name": "focus-ring-on-ink",
      "fg": "saffron",
      "bg": "ink",
      "size": "ui"
    },
    {
      "name": "qr-modules",
      "fg": "black",
      "bg": "white",
      "size": "ui"
    }
  ],
  "identity": {
    "rule": "Every seat gets a number and a colour. Numbers are unique in the room and carry identity for any N; colours cycle through this list in order (seat N takes colour (N-1) mod 12), so colours repeat with distinct numbers as N grows. No cap (R66). Patterns are Full (plan §2.3).",
    "numberFormat": "#{n}, any number of digits, tabular figures",
    "badge": "Number in the display face on the seat colour, ink outline, sticker shadow; text colour is the colour's `on` value",
    "colors": [
      {
        "name": "red",
        "hex": "#E5322D",
        "on": "paper"
      },
      {
        "name": "blue",
        "hex": "#2563EB",
        "on": "paper"
      },
      {
        "name": "orange",
        "hex": "#FF7A1A",
        "on": "ink"
      },
      {
        "name": "teal",
        "hex": "#00B5B8",
        "on": "ink"
      },
      {
        "name": "yellow",
        "hex": "#FFD23F",
        "on": "ink"
      },
      {
        "name": "pink",
        "hex": "#FF4FA3",
        "on": "ink"
      },
      {
        "name": "charcoal",
        "hex": "#2A2D34",
        "on": "paper"
      },
      {
        "name": "green",
        "hex": "#22A447",
        "on": "ink"
      },
      {
        "name": "white",
        "hex": "#F4F1EA",
        "on": "ink"
      },
      {
        "name": "purple",
        "hex": "#8B3FD9",
        "on": "paper"
      },
      {
        "name": "maroon",
        "hex": "#8E1B3F",
        "on": "paper"
      },
      {
        "name": "sky",
        "hex": "#5EC8FF",
        "on": "ink"
      }
    ],
    "cvdMinDeltaE": 20
  },
  "fonts": {
    "display": {
      "family": "Barlow Condensed",
      "role": "Event titles, headings, numbers, countdowns, room codes",
      "licence": "OFL-1.1",
      "licenceFile": "fonts/OFL.txt",
      "files": [
        {
          "weight": 800,
          "style": "normal",
          "file": "fonts/barlow-condensed-800.woff2"
        },
        {
          "weight": 900,
          "style": "normal",
          "file": "fonts/barlow-condensed-900.woff2"
        },
        {
          "weight": 900,
          "style": "italic",
          "file": "fonts/barlow-condensed-900-italic.woff2"
        }
      ]
    },
    "body": {
      "family": "Barlow Semi Condensed",
      "role": "Labels, controls, body copy, names",
      "licence": "OFL-1.1",
      "licenceFile": "fonts/OFL.txt",
      "files": [
        {
          "weight": 500,
          "style": "normal",
          "file": "fonts/barlow-semi-condensed-500.woff2"
        },
        {
          "weight": 600,
          "style": "normal",
          "file": "fonts/barlow-semi-condensed-600.woff2"
        },
        {
          "weight": 700,
          "style": "normal",
          "file": "fonts/barlow-semi-condensed-700.woff2"
        }
      ]
    },
    "fallback": [
      "system-ui",
      "-apple-system",
      "Segoe UI",
      "Noto Sans",
      "Noto Sans CJK SC",
      "Noto Sans Arabic",
      "Noto Sans Devanagari",
      "sans-serif"
    ],
    "fallbackNote": "The bundled faces cover Latin, Latin Extended and Vietnamese. Other scripts (CJK, Arabic, Devanagari, Cyrillic, Greek…) fall back to the device's own system font, never a remote font service (R70).",
    "numeric": "tabular-nums",
    "subset": "U+0000-024F, U+0300-036F, U+1E00-1EFF, punctuation, currency, arrows (fonts/subset.py)"
  },
  "type": {
    "profiles": {
      "tv": {
        "viewing": "TV at about 3 m, sized on a 1920x1080 reference; scale every value by the output height / 1080",
        "unit": "px@1080p",
        "minTextPx": 24,
        "minCapHeightPx": 17,
        "scale": {
          "caption": 24,
          "label": 28,
          "body": 32,
          "title": 44,
          "heading": 64,
          "display": 96,
          "hero": 144
        }
      },
      "desk": {
        "viewing": "Laptop or desktop at about 60 cm",
        "unit": "css-px",
        "minTextPx": 12,
        "minCapHeightPx": 8,
        "scale": {
          "caption": 13,
          "label": 14,
          "body": 16,
          "title": 22,
          "heading": 32,
          "display": 48,
          "hero": 72
        }
      },
      "handheld": {
        "viewing": "Phone held at about 30 cm",
        "unit": "css-px",
        "minTextPx": 13,
        "minCapHeightPx": 9,
        "scale": {
          "caption": 13,
          "label": 15,
          "body": 17,
          "title": 22,
          "heading": 28,
          "display": 40,
          "hero": 56
        }
      }
    },
    "lineHeight": {
      "display": 0.95,
      "body": 1.3
    },
    "letterSpacing": {
      "display": "0.01em",
      "body": "0"
    },
    "displayCase": "uppercase for titles and headings; sentence case for labels and buttons"
  },
  "space": {
    "unit": "the profile's unit (tv: px@1080p, desk and handheld: css-px)",
    "steps": [
      0,
      4,
      8,
      12,
      16,
      24,
      32,
      48,
      64,
      96,
      128
    ],
    "profileMultiplier": {
      "tv": 2,
      "desk": 1,
      "handheld": 1
    }
  },
  "layout": {
    "minTouchTargetPx": 48,
    "minTouchGapPx": 8,
    "stickRegion": "Each controller stick region spans at least 45% of the screen's long side and the full lower two-thirds in landscape (C02 tunes)",
    "tvSafe": {
      "title": 0.05,
      "action": 0.035,
      "note": "Fractions of each screen dimension: text and the QR stay inside title-safe, other chrome inside action-safe; tiles may bleed to the edge"
    },
    "radiusPx": {
      "tv": 10,
      "desk": 8,
      "handheld": 10
    }
  },
  "ink": {
    "outlinePx": {
      "tv": 4,
      "desk": 3,
      "handheld": 2.5
    },
    "stickerShadow": {
      "x": 0,
      "y": 5,
      "blur": 0,
      "color": "ink",
      "opacity": 0.85,
      "note": "Hard offset, never blurred; y scales with the profile like outlinePx (desk 5 px, TV about 6.7 px at 1080p)"
    },
    "stickerShadowOnInk": {
      "color": "black",
      "opacity": 0.55,
      "note": "On ink surfaces an ink shadow vanishes; use black at 55 %"
    }
  },
  "wobble": {
    "amplitudePx": {
      "tv": 2.5,
      "desk": 1.5,
      "handheld": 1.5
    },
    "segmentsPerEdge": [
      5,
      9
    ],
    "seed": "a hash of the element's stable id, so each panel keeps the same edge everywhere and across reloads",
    "animated": false,
    "appliesTo": "Panel and badge outlines only. Text baselines, content boxes, hit boxes and focus rings stay straight rectangles.",
    "note": "Master §12.1: a few px at TV scale, consistent per element, never animated"
  },
  "focus": {
    "keyboard": {
      "ring": "cobalt",
      "onInk": "saffron",
      "widthPx": {
        "tv": 6,
        "desk": 3,
        "handheld": 3
      },
      "offsetPx": {
        "tv": 4,
        "desk": 2,
        "handheld": 2
      }
    },
    "gamepad": {
      "ring": "saffron",
      "widthPx": {
        "tv": 8,
        "desk": 4,
        "handheld": 4
      },
      "offsetPx": {
        "tv": 4,
        "desk": 2,
        "handheld": 2
      },
      "marker": "A saffron chevron tab on the focused element's leading edge, so the selection reads from the couch",
      "lift": "translateY(-2px) plus a deeper sticker shadow",
      "edge": {
        "color": "ink",
        "widthPx": 1.5,
        "note": "An ink hairline either side of the saffron ring: saffron alone is about 1.6:1 against paper"
      }
    },
    "note": "Focus is always visible on keyboard and gamepad navigation; it is never removed for looks (experience direction §3)"
  },
  "icons": {
    "source": "Lucide (ISC licence), vendored as SVG in icons/",
    "licenceFile": "icons/LICENSE",
    "strokeWidth": 2.5,
    "grid": 24,
    "color": "currentColor",
    "set": [
      "play",
      "pause",
      "settings",
      "users",
      "user-plus",
      "user-minus",
      "eye-off",
      "qr-code",
      "gamepad-2",
      "keyboard",
      "smartphone",
      "monitor",
      "wifi",
      "wifi-off",
      "triangle-alert",
      "check",
      "x",
      "chevron-left",
      "chevron-right",
      "rotate-ccw",
      "log-out",
      "car",
      "flag",
      "trophy",
      "timer",
      "volume-2",
      "volume-x",
      "circle-help",
      "bug",
      "maximize"
    ]
  },
  "motion": {
    "durationsMs": {
      "instant": 0,
      "fast": 120,
      "base": 200,
      "slow": 320,
      "reveal": 600,
      "podium": 1200,
      "countdownBeat": 1000
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "sticker": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "named": {
      "sticker-in": {
        "durationMs": 320,
        "easing": "sticker",
        "does": "Scale 0.6 to 1 with a slight overshoot and a 4 degree settle",
        "reduced": {
          "durationMs": 120,
          "does": "Fade in, no scale or rotation"
        }
      },
      "identify-pulse": {
        "durationMs": 500,
        "repeat": 3,
        "does": "About 1.5 s (master §5.2): the seat's tile border and number badge pulse and scale up, a '#7 THAT'S YOU!' burst over the car, a bright outline on the car in other tiles; the controller flashes the same number and colour",
        "reduced": {
          "durationMs": 500,
          "repeat": 3,
          "does": "Border and badge step to the seat colour and back; the burst and outline show without scale"
        }
      },
      "countdown-beat": {
        "durationMs": 1000,
        "does": "Each number punches in (scale 1.4 to 1) and fades on the beat",
        "reduced": {
          "durationMs": 1000,
          "does": "Numbers swap on the beat, no scale"
        }
      },
      "reflow": {
        "durationMs": 320,
        "easing": "standard",
        "does": "Tiles slide to their new cells when players join or leave",
        "reduced": {
          "durationMs": 0,
          "does": "Tiles cut to their new cells"
        }
      },
      "results-reveal": {
        "durationMs": 1200,
        "easing": "sticker",
        "does": "Podium cards drop in from the top, staggered by 150 ms",
        "reduced": {
          "durationMs": 200,
          "does": "Cards fade in together"
        }
      },
      "toast": {
        "durationMs": 200,
        "easing": "enter",
        "does": "Slides in 16 px and fades; stays 4 s",
        "reduced": {
          "durationMs": 120,
          "does": "Fades only"
        }
      },
      "wreck-shake": {
        "durationMs": 300,
        "does": "A small screen shake on the wrecked player's tile only",
        "reduced": {
          "durationMs": 0,
          "does": "No shake; the comic impact word still shows"
        }
      }
    },
    "reducedMotionNote": "Reduced motion removes shake, flashes, overshoot and scale, never information, controls or timing (experience direction §2)"
  },
  "qr": {
    "rule": "Plain black-on-white code with a quiet zone of at least 4 modules on every side and nothing in the middle; error correction M; the room code sits beside it, never inside, in the display face",
    "quietZoneModules": 4,
    "errorCorrection": "M",
    "minModulePx": {
      "tv": 8,
      "desk": 4,
      "handheld": 4
    },
    "colors": {
      "modules": "black",
      "background": "white"
    }
  }
}
