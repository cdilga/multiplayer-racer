    },
    {
      "start": 14.233,
      "end": 17.69,
      "id": "grow64",
      "text": "Sixty-four drivers. One shared screen. And there's no player cap."
    },
    {
      "start": 20.317,
      "end": 23.053,
      "id": "race",
      "text": "This is Joystick Jammers. Bring the whole mob."
    },
    {
      "start": 23.803,
      "end": 27.98,
      "id": "tracks",
      "text": "Every track is generated fresh. Dirt, bitumen, town streets, and rocky country."
    },
    {
      "start": 30.553,
      "end": 33.53,
      "id": "loop",
      "text": "And then someone put a loop in the road. Completely reasonable."
    },
    {
      "start": 36.203,
      "end": 40.54,
      "id": "cars",
      "text": "Take the Cruz Missile, the A U Hawk, the Tradie Ute, or the Lion President."
    },
    {
      "start": 42.603,
      "end": 46.46,
      "id": "bikes",
      "text": "Or stir things up with the Pig Catcher, the Postie Bike, and the Hawk Dash."
    },
    {
      "start": 48.003,
      "end": 52.34,
      "id": "controllers",
      "text": "Your phone is the controller. Or bring a keyboard or a gamepad. Get everyone in."
    },
    {
      "start": 54.153,
      "end": 57.21,
      "id": "end",
      "text": "Joystick Jammers. Bring everyone. Play in your browser."
    }
  ],
