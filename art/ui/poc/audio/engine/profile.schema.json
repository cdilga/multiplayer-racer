{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jj.invalid/schemas/engine-profile.v1.json",
  "title": "Joystick Jammers engine profile (v1)",
  "description": "Generated by art/ui/poc/audio/engine/build.mjs from PROFILE_RULE in profile.ts. Cross-field rules (idle < redline <= limiter, falling gear ratios, ordered min/max pairs) are checked by validateProfile() only; JSON Schema cannot express them.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "description": "Pointer to the profile schema; kept by tooling, not a sound parameter."
    },
    "format": {
      "const": "jj-engine-profile",
      "description": "The format tag; must stay jj-engine-profile."
    },
    "version": {
      "const": 1,
      "description": "The profile contract version this file speaks."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable machine id (used in URLs and file names)."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name painted in the lab and the game."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "One breath of flavour text about how this car should sound."
    },
    "engine": {
      "type": "object",
      "properties": {
        "cylinders": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "description": "Cylinder count: sets the firing rate (rpm/60 × cylinders/2).",
          "x-unit": "cyl"
        },
        "idleRpm": {
          "type": "number",
          "minimum": 100,
          "maximum": 20000,
          "description": "Engine speed at closed throttle; also the lope idle.",
          "x-unit": "rpm"
        },
        "redlineRpm": {
          "type": "number",
          "minimum": 100,
          "maximum": 20000,
          "description": "Where the tach marks red; the note stops climbing past it.",
          "x-unit": "rpm"
        },
        "limiterRpm": {
          "type": "number",
          "minimum": 100,
          "maximum": 20000,
          "description": "The hard cut: the highest rpm any control may ask for.",
          "x-unit": "rpm"
        }
      },
      "required": [
        "cylinders",
        "idleRpm",
        "redlineRpm",
        "limiterRpm"
      ],
      "additionalProperties": false
    },
    "gearbox": {
      "type": "object",
      "properties": {
        "ratios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 20
          },
          "description": "Gear ratios highest (1st) to lowest; must fall.",
          "x-unit": "×"
        },
        "finalDrive": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 20,
          "description": "Final drive multiplied after the gearbox.",
          "x-unit": "×"
        },
        "wheelRadiusM": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 2,
          "description": "Driven wheel radius; converts rpm to road speed.",
          "x-unit": "m"
        },
        "upshiftRpm": {
          "type": "number",
          "minimum": 100,
          "maximum": 20000,
          "description": "The drivetrain shifts up at this engine speed.",
          "x-unit": "rpm"
        },
        "downshiftRpm": {
          "type": "number",
          "minimum": 100,
          "maximum": 20000,
          "description": "The drivetrain shifts back down below this.",
          "x-unit": "rpm"
        },
        "shiftTimeS": {
          "type": "number",
          "minimum": 0,
          "maximum": 3,
          "description": "How long a change takes (the lap driver pauses throttle).",
          "x-unit": "s"
        },
        "launchRpm": {
          "type": "number",
          "minimum": 100,
          "maximum": 20000,
          "description": "Clutch-drop speed when pulling away from rest.",
          "x-unit": "rpm"
        },
        "rpmRiseTauS": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 5,
          "description": "How quickly free revs rise (smaller is snappier).",
          "x-unit": "s"
        },
        "rpmFallTauS": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 5,
          "description": "How quickly free revs fall back to idle.",
          "x-unit": "s"
        }
      },
      "required": [
        "ratios",
        "finalDrive",
        "wheelRadiusM",
        "upshiftRpm",
        "downshiftRpm",
        "shiftTimeS",
        "launchRpm",
        "rpmRiseTauS",
        "rpmFallTauS"
      ],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "level": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "Master level of the whole voice (A/B matching trims this).",
          "x-unit": "×"
        },
        "controlTauS": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 5,
          "description": "Glide time for every live parameter change.",
          "x-unit": "s"
        },
        "noiseSeed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Seed for every random choice (offsets, pop strengths).",
          "x-unit": "seed"
        }
      },
      "required": [
        "level",
        "controlTauS",
        "noiseSeed"
      ],
      "additionalProperties": false
    },
    "firing": {
      "type": "object",
      "properties": {
        "level": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "A layer loudness (1 is the section reference; above 1 pushes).",
          "x-unit": "×"
        },
        "offThrottleLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Firing loudness with the throttle shut (engine braking).",
          "x-unit": "0–1"
        },
        "mellow": {
          "type": "object",
          "properties": {
            "phase": {
              "enum": [
                "sine",
                "cosine"
              ],
              "description": "Which way the wave starts: sine from zero, cosine from full."
            },
            "harmonics": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 4
              },
              "description": "Overtone weights: [fundamental, 2nd, 3rd…] relative strengths.",
              "x-unit": "×"
            }
          },
          "required": [
            "phase",
            "harmonics"
          ],
          "additionalProperties": false,
          "description": "The base pulse wave: its shape sets the round body of the note."
        },
        "bright": {
          "type": "object",
          "properties": {
            "phase": {
              "enum": [
                "sine",
                "cosine"
              ],
              "description": "Which way the wave starts: sine from zero, cosine from full."
            },
            "harmonics": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 4
              },
              "description": "Overtone weights: [fundamental, 2nd, 3rd…] relative strengths.",
              "x-unit": "×"
            }
          },
          "required": [
            "phase",
            "harmonics"
          ],
          "additionalProperties": false,
          "description": "The brighter pulse added as revs and throttle rise."
        },
        "brightMax": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How much of the bright wave is mixed in at full song.",
          "x-unit": "0–1"
        },
        "bodyFilter": {
          "type": "object",
          "properties": {
            "minHz": {
              "type": "number",
              "minimum": 1,
              "maximum": 16000,
              "description": "Body low-pass at closed throttle (the note darkens off song).",
              "x-unit": "Hz"
            },
            "maxHz": {
              "type": "number",
              "minimum": 1,
              "maximum": 16000,
              "description": "Body low-pass at full throttle (the note opens up).",
              "x-unit": "Hz"
            },
            "q": {
              "type": "number",
              "minimum": 0.0001,
              "maximum": 100,
              "description": "Filter resonance: higher is a narrower, rangier band.",
              "x-unit": "Q"
            },
            "throttleOpen": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "How far open the throttle must be before the filter opens.",
              "x-unit": "0–1"
            }
          },
          "required": [
            "minHz",
            "maxHz",
            "q",
            "throttleOpen"
          ],
          "additionalProperties": false
        },
        "lope": {
          "type": "object",
          "properties": {
            "depth": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Idle-lope amplitude: the slow am/am wobble at low rpm.",
              "x-unit": "0–1"
            },
            "fadeOutRpmN": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 1,
              "description": "Fraction of redline where the lope is gone.",
              "x-unit": "×redline"
            }
          },
          "required": [
            "depth",
            "fadeOutRpmN"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "level",
        "offThrottleLevel",
        "mellow",
        "bright",
        "brightMax",
        "bodyFilter",
        "lope"
      ],
      "additionalProperties": false
    },
    "intake": {
      "type": "object",
      "properties": {
        "level": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "A layer loudness (1 is the section reference; above 1 pushes).",
          "x-unit": "×"
        },
        "minHz": {
          "type": "number",
          "minimum": 1,
          "maximum": 16000,
          "description": "Intake band-pass at low revs.",
          "x-unit": "Hz"
        },
        "maxHz": {
          "type": "number",
          "minimum": 1,
          "maximum": 16000,
          "description": "Intake band-pass at redline (it sweeps with revs).",
          "x-unit": "Hz"
        },
        "q": {
          "type": "number",
          "minimum": 0.0001,
          "maximum": 100,
          "description": "Filter resonance: higher is a narrower, rangier band.",
          "x-unit": "Q"
        }
      },
      "required": [
        "level",
        "minHz",
        "maxHz",
        "q"
      ],
      "additionalProperties": false
    },
    "exhaust": {
      "type": "object",
      "properties": {
        "level": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "A layer loudness (1 is the section reference; above 1 pushes).",
          "x-unit": "×"
        },
        "minHz": {
          "type": "number",
          "minimum": 1,
          "maximum": 16000,
          "description": "Exhaust low-pass at low revs.",
          "x-unit": "Hz"
        },
        "maxHz": {
          "type": "number",
          "minimum": 1,
          "maximum": 16000,
          "description": "Exhaust low-pass at redline.",
          "x-unit": "Hz"
        },
        "q": {
          "type": "number",
          "minimum": 0.0001,
          "maximum": 100,
          "description": "Filter resonance: higher is a narrower, rangier band.",
          "x-unit": "Q"
        },
        "pulseDepth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How deeply each firing pulse chops the exhaust (the chuff).",
          "x-unit": "0–1"
        },
        "pulseHarmonics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 4
          },
          "description": "Shape of the exhaust chop wave.",
          "x-unit": "×"
        }
      },
      "required": [
        "level",
        "minHz",
        "maxHz",
        "q",
        "pulseDepth",
        "pulseHarmonics"
      ],
      "additionalProperties": false
    },
    "boost": {
      "type": "object",
      "properties": {
        "level": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "A layer loudness (1 is the section reference; above 1 pushes).",
          "x-unit": "×"
        },
        "whineBaseHz": {
          "type": "number",
          "minimum": 1,
          "maximum": 16000,
          "description": "Turbo whine pitch at zero boost.",
          "x-unit": "Hz"
        },
        "whineSweepHz": {
          "type": "number",
          "minimum": 0,
          "maximum": 16000,
          "description": "How far the whine rises at full boost.",
          "x-unit": "Hz"
        },
        "whineRpmHz": {
          "type": "number",
          "minimum": 0,
          "maximum": 16000,
          "description": "Extra whine rise across the rev range.",
          "x-unit": "Hz"
        },
        "whooshLevel": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "The broadband hiss under the whine.",
          "x-unit": "×"
        },
        "whooshHz": {
          "type": "number",
          "minimum": 1,
          "maximum": 16000,
          "description": "Centre of the whoosh band-pass.",
          "x-unit": "Hz"
        },
        "whooshSweepHz": {
          "type": "number",
          "minimum": 0,
          "maximum": 16000,
          "description": "How far the whoosh centre rises with boost.",
          "x-unit": "Hz"
        }
      },
      "required": [
        "level",
        "whineBaseHz",
        "whineSweepHz",
        "whineRpmHz",
        "whooshLevel",
        "whooshHz",
        "whooshSweepHz"
      ],
      "additionalProperties": false,
      "description": "Turbo or supercharger. Optional: leave it out for a car without one (the Cruz Missile has none)."
    },
    "squeal": {
      "type": "object",
      "properties": {
        "level": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "A layer loudness (1 is the section reference; above 1 pushes).",
          "x-unit": "×"
        },
        "centerMinHz": {
          "type": "number",
          "minimum": 1,
          "maximum": 16000,
          "description": "Tyre-squeal resonance at the slip threshold.",
          "x-unit": "Hz"
        },
        "centerMaxHz": {
          "type": "number",
          "minimum": 1,
          "maximum": 16000,
          "description": "Squeal resonance at full slip.",
          "x-unit": "Hz"
        },
        "q": {
          "type": "number",
          "minimum": 0.0001,
          "maximum": 100,
          "description": "Filter resonance: higher is a narrower, rangier band.",
          "x-unit": "Q"
        },
        "secondRatio": {
          "type": "number",
          "minimum": 1,
          "maximum": 4,
          "description": "The second resonance sits at this multiple of the first.",
          "x-unit": "×"
        },
        "wobbleHz": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 60,
          "description": "How fast the squeal pitch wobbles.",
          "x-unit": "Hz"
        },
        "wobbleDepth": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How far the wobble sweeps the resonances.",
          "x-unit": "0–1"
        },
        "minSpeedMps": {
          "type": "number",
          "minimum": 0,
          "maximum": 400,
          "description": "Below this road speed there is no squeal.",
          "x-unit": "m/s"
        },
        "fullSpeedMps": {
          "type": "number",
          "minimum": 0,
          "maximum": 400,
          "description": "Road speed where the squeal is fully on.",
          "x-unit": "m/s"
        }
      },
      "required": [
        "level",
        "centerMinHz",
        "centerMaxHz",
        "q",
        "secondRatio",
        "wobbleHz",
        "wobbleDepth",
        "minSpeedMps",
        "fullSpeedMps"
      ],
      "additionalProperties": false
    },
    "surface": {
      "type": "object",
      "properties": {
        "level": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "A layer loudness (1 is the section reference; above 1 pushes).",
          "x-unit": "×"
        },
        "fullSpeedMps": {
          "type": "number",
          "minimum": 1,
          "maximum": 400,
          "description": "Road speed where the rumble reaches full level.",
          "x-unit": "m/s"
        },
        "speedExponent": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 4,
          "description": "How aggressively rumble grows with speed (1 is linear).",
          "x-unit": "exp"
        },
        "tarmac": {
          "type": "object",
          "properties": {
            "brown": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Rumble share (brown noise) for this surface.",
              "x-unit": "0–1"
            },
            "crackle": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Crackle share (loose grit) for this surface.",
              "x-unit": "0–1"
            },
            "cutoffHz": {
              "type": "number",
              "minimum": 1,
              "maximum": 16000,
              "description": "Low-pass cutoff the road noise is capped at.",
              "x-unit": "Hz"
            },
            "q": {
              "type": "number",
              "minimum": 0.0001,
              "maximum": 100,
              "description": "Filter resonance: higher is a narrower, rangier band.",
              "x-unit": "Q"
            },
            "level": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Overall share of this surface versus the others.",
              "x-unit": "0–1"
            }
          },
          "required": [
            "brown",
            "crackle",
            "cutoffHz",
            "q",
            "level"
          ],
          "additionalProperties": false,
          "description": "Smooth tarmac: mostly rumble, no crackle."
        },
        "dirt": {
          "type": "object",
          "properties": {
            "brown": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Rumble share (brown noise) for this surface.",
              "x-unit": "0–1"
            },
            "crackle": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Crackle share (loose grit) for this surface.",
              "x-unit": "0–1"
            },
            "cutoffHz": {
              "type": "number",
              "minimum": 1,
              "maximum": 16000,
              "description": "Low-pass cutoff the road noise is capped at.",
              "x-unit": "Hz"
            },
            "q": {
              "type": "number",
              "minimum": 0.0001,
              "maximum": 100,
              "description": "Filter resonance: higher is a narrower, rangier band.",
              "x-unit": "Q"
            },
            "level": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Overall share of this surface versus the others.",
              "x-unit": "0–1"
            }
          },
          "required": [
            "brown",
            "crackle",
            "cutoffHz",
            "q",
            "level"
          ],
          "additionalProperties": false,
          "description": "Packed dirt: more crackle, lower cutoff."
        },
        "gravel": {
          "type": "object",
          "properties": {
            "brown": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Rumble share (brown noise) for this surface.",
              "x-unit": "0–1"
            },
            "crackle": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Crackle share (loose grit) for this surface.",
              "x-unit": "0–1"
            },
            "cutoffHz": {
              "type": "number",
              "minimum": 1,
              "maximum": 16000,
              "description": "Low-pass cutoff the road noise is capped at.",
              "x-unit": "Hz"
            },
            "q": {
              "type": "number",
              "minimum": 0.0001,
              "maximum": 100,
              "description": "Filter resonance: higher is a narrower, rangier band.",
              "x-unit": "Q"
            },
            "level": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Overall share of this surface versus the others.",
              "x-unit": "0–1"
            }
          },
          "required": [
            "brown",
            "crackle",
            "cutoffHz",
            "q",
            "level"
          ],
          "additionalProperties": false,
          "description": "Loose gravel: the crackliest, darkest rumble."
        }
      },
      "required": [
        "level",
        "fullSpeedMps",
        "speedExponent",
        "tarmac",
        "dirt",
        "gravel"
      ],
      "additionalProperties": false
    },
    "rattle": {
      "type": "object",
      "properties": {
        "level": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "A layer loudness (1 is the section reference; above 1 pushes).",
          "x-unit": "×"
        },
        "baseRateHz": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 200,
          "description": "Rattle chop rate at idle (loose parts knocking).",
          "x-unit": "Hz"
        },
        "rpmRateScale": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "How much the knock rate rises across the revs.",
          "x-unit": "×"
        },
        "idleShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Rattle loudness with no damage (nothing should be left loose).",
          "x-unit": "0–1"
        },
        "bandsHz": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 1,
            "maximum": 16000,
            "description": "A frequency.",
            "x-unit": "Hz"
          },
          "description": "Centre frequencies of the metallic knock bands.",
          "x-unit": "Hz"
        },
        "q": {
          "type": "number",
          "minimum": 0.0001,
          "maximum": 100,
          "description": "Filter resonance: higher is a narrower, rangier band.",
          "x-unit": "Q"
        },
        "pulseHarmonics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 4
          },
          "description": "Shape of the knock chop wave.",
          "x-unit": "×"
        }
      },
      "required": [
        "level",
        "baseRateHz",
        "rpmRateScale",
        "idleShare",
        "bandsHz",
        "q",
        "pulseHarmonics"
      ],
      "additionalProperties": false
    },
    "pops": {
      "type": "object",
      "properties": {
        "level": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "A layer loudness (1 is the section reference; above 1 pushes).",
          "x-unit": "×"
        },
        "armThrottle": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Throttle above which the pop is armed while on the boost.",
          "x-unit": "0–1"
        },
        "fireThrottle": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Throttle below which an armed pop fires (the lift).",
          "x-unit": "0–1"
        },
        "minRpmN": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of redline below which no pop fires.",
          "x-unit": "×redline"
        },
        "burstMin": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "description": "Fewest cracks in one overrun burst.",
          "x-unit": "count"
        },
        "burstMax": {
