  },
  "collider": {
    "visualCoverageMin": 0.92,
    "comBelowCenter": true
  },
  "color": {
    "deltaE": 12,
    "tyreMaxLuminance": 0.15
  },
  "balance": {
    "winRateTolerance": 0.10,
    "pointBudget": 60,
    "archetypes": [
      { "id": "balanced",       "speed": 12, "acceleration": 12, "weight": 10, "handling": 12, "traction": 12 },
      { "id": "speed",          "speed": 18, "acceleration": 8,  "weight": 14, "handling": 8,  "traction": 10 },
      { "id": "heavy",          "speed": 14, "acceleration": 6,  "weight": 18, "handling": 6,  "traction": 14 },
      { "id": "accel-handling", "speed": 10, "acceleration": 16, "weight": 6,  "handling": 16, "traction": 10 },
      { "id": "twitchy-light",  "speed": 9,  "acceleration": 18, "weight": 4,  "handling": 18, "traction": 8 },
      { "id": "gimmick",        "speed": 8,  "acceleration": 8,  "weight": 16, "handling": 8,  "traction": 16 }
