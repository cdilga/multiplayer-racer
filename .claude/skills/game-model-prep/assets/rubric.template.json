    "rubricItems": [
      "wheels_present_and_grounded",
      "no_wheel_orbit",
      "upright_not_inverted",
      "single_coherent_vehicle",
      "no_black_or_inverted_faces",
      "color_matches_manifest",
      "tyres_neutral",
      "number_legible_topdown",
      "reads_as_archetype",
      "on_brand_neon"
    ],
    "verdictSchema": {
      "items": "array of {id, pass:boolean, confidence:number, note:string}",
      "verdict": "pass | fail | needs-human"
    }
  }
